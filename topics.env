# Single source of truth for ops-group routing. Read by ops-notify.sh,
# monitor.sh, backup.sh and the deploy workflows. Do NOT hardcode thread ids
# anywhere else.
#
# Format (one per line):   name: <thread_id | general>  <emoji>
#   - numeric  -> message_thread_id=<id>
#   - general  -> the field is OMITTED. The group's General topic is addressed
#                 by omitting message_thread_id; thread id 1 is rejected by the
#                 Bot API with "message thread not found" (verified 2026-11-14).
# The emoji after the id is the project marker shown in message headers.
# Chat id and bot token live in ~/heylark/monitor.env (never here).
#
# Topic names as reported by the Bot API on 2026-11-14:
#   2 klgpff, 9 Nexus, 10 Arcana, 17 server, 30 jobhunter, 508 heylark.dev,
#   509 cats, 1182 "Zarya / Booking", 1690 santa, 2219 mcp

general:     general
server:      17     🖥
heylark.dev: 508    🏠
cats:        509    🐈
job-hunter:  30     🎯
klgpff:      2      🤖
nexus:       9      ☀️
arcana:      10     🌒
zarya:       1182   ⭐
santa:       1690   🎅
kai-mcp:     2219   🔌
bimbocv:     general 📄
login:       general 🔑
bunfarm:     general 🌾
